# Coverage
coverage/

# Exceptions to above rules.
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages

# Firebase - Keep these files for deployment
# Keep firebase configuration files
!firebase.json
!.firebaserc
!firebase/
!firebase/**/*

# Keep Firebase Functions
!firebase/functions/
!firebase/functions/**/*

# Keep Firestore rules and indexes
!firebase/firestore.rules
!firebase/firestore.indexes.json
!firebase/storage.rules

# But ignore Firebase debug logs and cache
firebase/firebase-debug.log
firebase/firestore-debug.log
firebase/ui-debug.log
firebase/database-debug.log
firebase/pubsub-debug.log
firebase/functions/node_modules/
firebase/functions/.nyc_output/
firebase/functions/coverage/
firebase/functions/lib/

